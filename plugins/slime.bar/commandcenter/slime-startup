#!/usr/bin/env bash
# Slime Shell start-up apps (Settings > Start-Up tab).
#
#   slime-startup           launch every enabled app in startup.json, moving
#                           each new window to its workspace (silently)
#   slime-startup install   add the fenced hook to ~/.config/hypr/autostart.lua
#   slime-startup status    print whether the hook is installed (yes/no)
#
# startup.json: [{"id": "<desktop id>", "name": "...", "workspace": 0|1..10,
#                 "enabled": true}]  — workspace 0 means "wherever it opens".
set -uo pipefail

config="$HOME/.config/omarchy/slime-shell/startup.json"
autostart="$HOME/.config/hypr/autostart.lua"
self="$HOME/.config/omarchy/plugins/slime.bar/commandcenter/slime-startup"
begin="-- >>> slime-shell startup >>>"
end="-- <<< slime-shell startup <<<"

case "${1:-run}" in
  status)
    grep -qF -e "$begin" "$autostart" 2>/dev/null && echo yes || echo no
    exit 0
    ;;
  install)
    # (-e: the marker starts with "--", which grep would read as an option)
    grep -qF -e "$begin" "$autostart" 2>/dev/null && exit 0
    cp "$autostart" "$autostart.bak.$(date +%s)" 2>/dev/null
    {
      echo ""
      echo "$begin"
      echo "-- Written by Slime Shell (Settings > Start-Up). Apps and workspaces live in"
      echo "-- ~/.config/omarchy/slime-shell/startup.json; remove this block to disable."
      echo "o.exec_on_start(\"$self\")"
      echo "$end"
    } >> "$autostart"
    exit 0
    ;;
esac

[[ -f $config ]] || exit 0

# one run at a time (a second one would launch everything twice)
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/slime-startup.lock"
flock -n 9 || exit 0

addresses() { hyprctl clients -j 2>/dev/null | jq -r '.[].address' | sort; }
# the window class an app's windows get: its StartupWMClass, else its id
wmclass() {
  local f
  for f in "$HOME/.local/share/applications/$1.desktop" /usr/share/applications/"$1".desktop \
           /var/lib/flatpak/exports/share/applications/"$1".desktop; do
    [[ -f $f ]] && { sed -n 's/^StartupWMClass=//p' "$f" | head -1; break; }
  done
}

jq -c '.[] | select(.enabled != false)' "$config" | while read -r app; do
  id=$(jq -r '.id' <<<"$app")
  ws=$(jq -r '.workspace // 0' <<<"$app")
  # a desktop id (no "/" to wander off with) and a workspace number: these go
  # into paths, bash arithmetic and a Hyprland dispatch, so nothing else passes
  [[ $id =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]] || continue
  [[ $ws =~ ^[0-9]{1,2}$ ]] && ws=$((10#$ws)) || ws=0
  class=$(wmclass "$id"); class=${class:-$id}
  before=$(addresses)
  uwsm-app -- gtk-launch "$id.desktop" >/dev/null 2>&1 &
  (( ws > 0 )) || continue
  # wait (up to 25 s) for the app's first new window, then move it quietly
  for _ in $(seq 100); do
    sleep 0.25
    # a new window of this app (not whatever else opened at login meanwhile)
    new=$(comm -13 <(echo "$before") <(addresses) | while read -r a; do
      hyprctl clients -j | jq -r --arg a "$a" --arg c "$class" \
        '.[] | select(.address == $a and ((.class | ascii_downcase) == ($c | ascii_downcase) or (.initialClass | ascii_downcase) == ($c | ascii_downcase))) | .address'
    done | head -1)
    if [[ -n $new ]]; then
      hyprctl dispatch "hl.dsp.window.move({ workspace = \"$ws\", follow = false, window = \"address:$new\" })" >/dev/null
      break
    fi
  done
done
