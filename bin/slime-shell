#!/usr/bin/env bash
# Install Slime Shell's plugins into Omarchy and switch the bar to/from it.
#
#   slime-shell install   copy plugins/slime.* into ~/.config/omarchy/plugins
#   slime-shell sync      copy them in again (after editing this checkout);
#                         the git hooks from `install --dev-hooks` do it on commit
#   slime-shell install --dev-hooks   also add those hooks to this checkout
#   slime-shell use       back up the current bar config, switch to slime.bar
#   slime-shell restore   put the backed-up bar config back
#   (with Shell-Swapper installed, use / restore swap through it instead)
#   slime-shell status    show which bar is active
#
# The Omarchy shell only loads third-party widgets that are in the bar layout,
# so switching swaps the whole `bar` subtree of shell.json. Slime's own
# services (notifications) are enabled in place of Omarchy's, and overlays that
# other bars draw over the top edge (Ruixen's notch) are disabled while Slime is
# active. The previous bar, plugin list and disabled list are kept in
# ~/.config/omarchy/slime-shell/previous-bar.json until restored.
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
plugins_dir="$HOME/.config/omarchy/plugins"
shell_json="$HOME/.config/omarchy/shell.json"
state_dir="$HOME/.config/omarchy/slime-shell"
backup="$state_dir/previous-bar.json"
# Plugins disabled while Slime is active: other bars' companions that paint
# over the top edge, and the Omarchy services Slime replaces (only one
# notification server can run).
disable_while_active='["ruixen.notch", "omarchy.notifications"]'
# Slime services enabled while active.
slime_services='[{"id": "slime.notifications"}]'

current_bar() { jq -r '.bar.id // "omarchy.bar"' "$shell_json"; }

edit_shell_json() {
  local tmp
  tmp="$(mktemp "$shell_json.XXXXXX")"
  jq "$@" "$shell_json" > "$tmp"
  mv "$tmp" "$shell_json"
}

# The plugins are copied in as real folders, not linked: some shells' plugin
# catalogs (Shibumi's) won't follow a symlinked plugin folder, and then list
# no third-party plugins at all. Each copy carries .synced-from (this
# checkout's plugin folder), so the Updates tab and Shell-Swapper can find the
# repo. A folder that isn't one of ours is never touched; a link from an
# older install is swapped for its folder in one step (mv --exchange), so the
# plugin never goes missing while the shell is running.
sync_plugins() {
  mkdir -p "$plugins_dir"
  local dir name dest tmp
  for dir in "$repo"/plugins/slime.*; do
    name=${dir##*/}
    dest="$plugins_dir/$name"
    if [[ -L $dest ]]; then
      tmp="$plugins_dir/.sync-$name"
      rm -rf "$tmp"
      rsync -a --exclude __pycache__ --exclude .git "$dir/" "$tmp/"
      printf '%s\n' "$dir" > "$tmp/.synced-from"
      # -T: swap the link itself, never move into the folder it points at
      mv -T --exchange "$tmp" "$dest" || { rm -rf "$tmp"; echo "couldn't replace the link $dest" >&2; return 1; }
      [[ -L $tmp ]] && rm -f "$tmp"   # the old link (only ever a link here)
    elif [[ -e $dest && ! -f $dest/.synced-from ]]; then
      echo "skipping $name: $dest is there and isn't Slime Shell's copy" >&2
      continue
    else
      rsync -a --delete --delay-updates --exclude __pycache__ --exclude .git --exclude .synced-from "$dir/" "$dest/"
      [[ $(cat "$dest/.synced-from" 2>/dev/null) == "$dir" ]] || printf '%s\n' "$dir" > "$dest/.synced-from"
    fi
  done
}

dev_hooks() {
  local hooks="$repo/.git/hooks" h
  [[ -d $hooks ]] || { echo "not a git checkout: no hooks" >&2; return; }
  for h in post-commit post-merge post-checkout; do
    if [[ -e $hooks/$h ]] && ! grep -q 'slime-shell sync' "$hooks/$h"; then
      echo "skipping the $h hook: there's one already" >&2
      continue
    fi
    printf '#!/bin/sh\n# Slime Shell: copy the plugins into Omarchy after the checkout changes\n"%s" sync >/dev/null 2>&1 &\n' \
      "$repo/bin/slime-shell" > "$hooks/$h"
    chmod +x "$hooks/$h"
  done
  echo "git hooks: plugins are copied in after every commit, pull and checkout"
}

install_plugins() {
  sync_plugins
  omarchy-shell -q shell rescanPlugins
  # Discovery is asynchronous; wait until every slime plugin is listed.
  local want
  want=$(find "$repo"/plugins -maxdepth 1 -name 'slime.*' | wc -l)
  for _ in $(seq 40); do
    (( $(omarchy-plugin-list --json 2>/dev/null | jq '[.[] | select(.id | startswith("slime."))] | length') >= want )) && break
    sleep 0.1
  done
  echo "installed $(find "$repo"/plugins -maxdepth 1 -name 'slime.*' | wc -l) plugins"
  # the tasks command, for agents and scripts
  mkdir -p "$HOME/.local/bin"
  ln -sfn "$repo/bin/slime-tasks" "$HOME/.local/bin/slime-tasks"
  # your own wallpapers (the command centre's Wallpapers tab lists them too)
  mkdir -p "$HOME/Pictures/SlimeS-Wallpapers"
}

# With Shell-Swapper installed, it does the swapping: your Slime layout is kept
# as a loadout, every swap is backed up and asks before it sticks.
swapper=""
command -v shell-swapper >/dev/null 2>&1 && swapper=shell-swapper

case "${1:-status}" in
  install)
    install_plugins
    if [[ ${2:-} == --dev-hooks ]]; then dev_hooks; fi
    ;;
  sync)
    sync_plugins
    ;;
  use)
    install_plugins
    if [[ -n $swapper ]]; then
      "$swapper" apply --suite slime.bar
      echo "swapping to slime.bar with Shell-Swapper (keep it when it asks)"
      exit 0
    fi
    mkdir -p "$state_dir"
    if [[ $(current_bar) != slime.bar ]]; then
      jq '{bar: .bar, plugins: (.plugins // []), disabledPlugins: (.disabledPlugins // [])}' "$shell_json" > "$backup"
      echo "backed up $(current_bar) config to $backup"
    fi
    # shellcheck disable=SC2016  # $bar/$off/$services are jq variables
    edit_shell_json --slurpfile bar "$repo/layouts/default.json" \
      --argjson off "$disable_while_active" --argjson services "$slime_services" '
      .bar = $bar[0]
      | .disabledPlugins = ((.disabledPlugins // []) + $off | unique)
      | .plugins = ((.plugins // []) | map(select(.id as $id | $services | map(.id) | index($id) | not))) + $services'
    omarchy restart shell
    echo "switched to slime.bar (undo with: slime-shell restore)"
    ;;
  restore)
    if [[ -n $swapper ]]; then
      "$swapper" apply --previous
      echo "swapping back with Shell-Swapper (keep it when it asks)"
      exit 0
    fi
    [[ -f $backup ]] || { echo "no backup at $backup" >&2; exit 1; }
    # shellcheck disable=SC2016  # $saved/$services are jq variables
    edit_shell_json --slurpfile saved "$backup" --argjson services "$slime_services" '
      .bar = $saved[0].bar
      | .disabledPlugins = $saved[0].disabledPlugins
      | .plugins = ($saved[0].plugins
          // ((.plugins // []) | map(select(.id as $id | $services | map(.id) | index($id) | not))))'
    omarchy restart shell
    echo "restored $(current_bar)"
    ;;
  status)
    echo "active bar: $(current_bar)"
    [[ -f $backup ]] && echo "backup: $backup ($(jq -r '.bar.id // "omarchy.bar"' "$backup"))"
    [[ -n $swapper ]] && echo "shell-swapper: $("$swapper" status)"
    ;;
  *)
    sed -n '2,8p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
